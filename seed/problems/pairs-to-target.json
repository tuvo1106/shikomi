{
  "slug": "pairs-to-target",
  "title": "Pairs to Target",
  "difficulty": "easy",
  "statement_md": "Return **every** pair of positions `[i, j]` with `i < j` whose values in `nums` add up to `target`. Equal values at different positions form separate pairs.\n\nThe pairs may be listed in any order, but each pair lists the smaller position first.",
  "languages": [
    {"language": "python", "function_name": "pairs_to_target", "starter_code": "def pairs_to_target(nums: list[int], target: int) -> list[list[int]]:\n    pass\n", "params": [{"name": "nums", "type": "list[int]"}, {"name": "target", "type": "int"}]},
    {"language": "rust", "function_name": "pairs_to_target", "starter_code": "fn pairs_to_target(nums: Vec<i32>, target: i32) -> Vec<(usize, usize)> {\n    todo!()\n}\n", "params": [{"name": "nums", "type": "Vec<i32>"}, {"name": "target", "type": "i32"}], "note_md": "Values span the whole `i32` range, so a sum of two can overflow, and overflow panics here. Widen to `i64` before adding."}
  ],
  "comparison": {"mode": "unordered"},
  "time_limit_ms": 2000,
  "memory_limit_mb": 256,
  "is_published": true,
  "tags": ["array", "hash-table"],
