647], [3918, 3947], [7483, 7515], [1959, 2013], [3067, 3114], [178, 192], [6561, 6605], [6244, 6272], [5510, 5541], [1117, 1126], [6623, 6666], [6543, 6583]]], "expected": [[29, 31], [122, 192], [238, 349], [384, 415], [424, 429], [439, 458], [470, 557], [584, 704], [743, 748], [760, 781], [785, 787], [827, 877], [921, 971], [985, 1189], [1191, 1208], [1210, 1221], [1226, 1229], [1248, 1425], [1456, 1487], [1504, 1521], [1534, 1550], [1558, 1584], [1598, 1646], [1720, 1721], [1741, 2013], [2030, 2085], [2098, 2146], [2155, 2167], [2184, 2283], [2286, 2292], [2301, 2387], [2391, 2402], [2405, 2459], [2675, 2751], [2760, 2813], [2828, 2923], [2976, 3019], [3049, 3114], [3127, 3247], [3256, 3299], [3332, 3333], [3337, 3363], [3380, 3417], [3439, 3452], [3469, 3517], [3530, 3570], [3589, 3610], [3615, 3617], [3624, 3635], [3640, 3678], [3703, 3728], [3733, 3752], [3777, 3827], [3830, 3863], [3866, 3974], [3979, 4008], [4041, 4077], [4094, 4119], [4134, 4146], [4182, 4291], [4294, 4314], [4354, 4357], [4362, 4446], [4461, 4479], [4501, 4514], [4527, 4731], [4753, 4818], [4829, 4834], [4870, 4907], [4924, 4967], [4978, 5060], [5107, 5116], [5138, 5162], [5180, 5252], [5283, 5298], [5344, 5371], [5445, 5451], [5486, 5507], [5510, 5541], [5578, 5647], [5673, 5731], [5779, 5828], [5847, 5855], [5881, 5942], [5957, 6015], [6074, 6121], [6190, 6195], [6211, 6227], [6229, 6306], [6328, 6361], [6391, 6444], [6469, 6666], [6689, 6731], [6772, 6832], [6867, 6906], [6965, 6976], [6992, 7028], [7029, 7087], [7104, 7156], [7163, 7252], [7253, 7516], [7520, 7573], [7596, 7670], [7724, 7759], [7774, 7808], [7854, 7883], [7931, 7980]], "is_sample": false}
